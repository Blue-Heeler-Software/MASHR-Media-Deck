{
  "manifest_version": 3,
  "name": "MASHR Media Deck YouTube Bridge",
  "version": "1.1.0",
  "description": "Optional: adds only the related-video grid to the extension-free MASHR Media Deck core.",
  "host_permissions": [
    "http://127.0.0.1:43821/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
