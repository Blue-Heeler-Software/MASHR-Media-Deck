<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>MASHR Media Deck Companion</AssemblyTitle>
    <Product>MASHR Media Deck</Product>
    <Description>Secure local second-screen media remote for PC gamers</Description>
    <Version>1.9.11</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <DefaultItemExcludes>$(DefaultItemExcludes);.artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
